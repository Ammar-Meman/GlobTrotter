PORT=5000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/globetrotter?schema=public"

# SECURITY: Generate a strong random secret: openssl rand -base64 64
JWT_SECRET="REPLACE_WITH_A_STRONG_RANDOM_SECRET"
JWT_EXPIRES_IN="7d"

# SECURITY: Set to the exact origin(s) your frontend is served from.
# Comma-separate multiple origins. Defaults to http://localhost:5173.
CORS_ORIGINS="http://localhost:5173"

NODE_ENV=development

CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Discovery API keys — optional. Services fall back to mock data when not set.
GEOAPIFY_API_KEY=""
PEXELS_API_KEY=""
